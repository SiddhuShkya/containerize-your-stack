# .env should NOT be committed to version control.
# Copy this file to .env and fill in your values.

POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Inside Docker Compose the host is the service name "postgres".
# For local development outside Docker, change this to "localhost".
POSTGRES_HOST=postgres

# Full connection string used by the application to connect to Postgres.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://appuser:changeme@postgres:5432/appdb